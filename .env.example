# Supabase — public project URL + anonymous (publishable) key.
# These are safe to expose in the browser; all privileged work happens
# server-side in Supabase Auth and Postgres (see supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: origin used when building the email verification link.
# Defaults to window.location.origin at runtime.
VITE_SITE_URL=
